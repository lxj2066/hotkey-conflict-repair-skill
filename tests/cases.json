{
  "version": "1.0.0",
  "note": "断言只增不改口径。要让用例变绿，先改包，不许改断言。",
  "cases": [
    {
      "name": "本包自检不应有 BLOCKER",
      "kind": "path",
      "path": "..",
      "expect": { "kind": "skill", "blocker": 0, "min_score": 95 }
    },
    {
      "name": "外层 Agent 包不应有 BLOCKER",
      "kind": "path",
      "path": "../../../agents/hotkey-conflict-repair-agent",
      "optional": true,
      "expect": { "kind": "agent", "blocker": 0, "min_score": 95 }
    },
    {
      "name": "空输入应被拒绝而非给分",
      "kind": "missing",
      "path": "./__not_exist__",
      "expect": { "exit": 2 }
    }
  ]
}
